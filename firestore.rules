rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 관리자: admins/{uid} 문서가 있는 계정. 등록은 시트의 [팩토리얼] → [3. 관리자 등록]으로만 (사이트에서는 못 만듦)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 회원 정보: 본인만 읽고 씀. 무료 답지·초대 수·초대 코드는 본인이 못 바꿈.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.freeKeys == 0
        && request.resource.data.invited == 0
        && !request.resource.data.keys().hasAny(['tfCoupon', 'inviteGranted', 'inviterUid', 'inviterPaid']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['freeKeys', 'invited', 'inviteCode', 'invitedBy', 'tfCoupon', 'inviteGranted', 'inviterUid', 'inviterPaid']));
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // 주문·신청: 본인 것만 보고, 새로 만들 때는 '접수' 단계로만. 단계 변경은 관리자만.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stage == 0
        && request.resource.data.cancelled == false
        // 서버(시트)만 쓰는 칸은 주문 만들 때 못 넣음
        && !request.resource.data.keys().hasAny(['freeHeld', 'couponHeld', 'perksRefunded', 'perkError', 'sentAt', 'sendError', 'noticeAt', 'sendLink', 'paidAs']);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled', 'cancelledAt'])
        && request.resource.data.cancelled == true);
      allow delete: if isAdmin();
    }
  }
}
